rules_version = '2';

// Access is driven by the `members` collection (doc id = lowercase email,
// fields: name, role = "owner" | "friend"). Members are managed from the
// Firebase console only; the app can never add or change a member.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.token.email.lower());
    }

    function isMember() {
      return signedIn() && exists(memberPath());
    }

    function isOwner() {
      return signedIn() && get(memberPath()).data.role == "owner";
    }

    match /members/{email} {
      allow read: if isMember();
      allow write: if false;
    }

    // Loan settings and the financier schedule: everyone reads, owner writes.
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    match /financier_payments/{docId} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    // Friend payments: both members can log and edit.
    match /friend_payments/{docId} {
      allow read, write: if isMember();
    }

    // Web Push subscriptions, one per browser (id = first 40 hex chars of
    // SHA-256 of the endpoint). Each member sees only their own; the server
    // reads them with the Admin SDK. Saving an existing id re-links that
    // browser to whoever is signed in on it now.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function validSubscription(subId) {
      let data = request.resource.data;
      return subId.matches('[0-9a-f]{40}')
        && data.keys().hasAll(['email', 'subscription'])
        && data.keys().hasOnly(['email', 'subscription', 'user_agent', 'created_at', 'updated_at'])
        && data.email == myEmail()
        && data.subscription is map
        && data.subscription.keys().hasOnly(['endpoint', 'keys'])
        && data.subscription.endpoint is string
        && data.subscription.endpoint.matches('https://.+')
        && data.subscription.endpoint.size() <= 1024
        && data.subscription['keys'].keys().hasOnly(['p256dh', 'auth'])
        && data.subscription['keys'].p256dh is string
        && data.subscription['keys'].auth is string;
    }

    match /push_subscriptions/{subId} {
      allow get, delete: if isMember() && (resource == null || resource.data.email == myEmail());
      allow list: if isMember() && resource.data.email == myEmail();
      allow create, update: if isMember() && validSubscription(subId);
    }

    // Receipts are stored as Firestore documents split into <1 MiB chunks,
    // so no Cloud Storage bucket (and no Blaze plan) is needed.
    match /receipts/{fileId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uploaded_by == request.auth.token.email.lower()
        && request.resource.data.size <= 10 * 1024 * 1024;
      allow update, delete: if isOwner();

      match /chunks/{chunkId} {
        allow read: if isMember();
        allow create: if isMember();
        allow update, delete: if isOwner();
      }
    }
  }
}
